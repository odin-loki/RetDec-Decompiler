{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_gen",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "_optionDefaults",
      "hidden": true,
      "description": "Every cache variable any preset below sets, at the default cmake/options.cmake gives it. A preset's cacheVariables reach the configure the way -D does and overwrite the cache; a variable a preset does NOT name keeps whatever the previous configure left in that build directory, and the presets below share two of them. Inheriting this gives every preset the same key set, so nothing can carry over. RETDEC_BUNDLED_OPENSSL is not here because its default is platform-dependent -- it lives in _pathWin and _pathUnix, which are per-directory anyway. scripts/ci/check_cmake_presets.py holds the invariant.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_C_FLAGS": "",
        "CMAKE_CXX_FLAGS": "",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "RETDEC_TESTS": "OFF",
        "RETDEC_USE_ADDRESS_SANITIZER": "OFF",
        "RETDEC_ENABLE_RETDEC": "OFF",
        "RETDEC_ENABLE_RETDEC_DECOMPILER": "OFF",
        "RETDEC_ENABLE_FILEFORMAT": "OFF",
        "RETDEC_ENABLE_BIN2LLVMIR": "OFF",
        "RETDEC_ENABLE_LLVMIR2HLL": "OFF",
        "RETDEC_ENABLE_DEMANGLER": "OFF",
        "RETDEC_ENABLE_COMMON": "OFF",
        "RETDEC_ENABLE_CONFIG": "OFF",
        "RETDEC_ENABLE_CUDA_ACCEL": "OFF",
        "RETDEC_REQUIRE_QT6": "OFF"
      }
    },
    {
      "name": "_pathWin",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/windows",
      "installDir": "${sourceDir}/install/windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "RETDEC_BUNDLED_OPENSSL": "ON"
      }
    },
    {
      "name": "_pathUnix",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/linux",
      "installDir": "${sourceDir}/install/linux",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "RETDEC_BUNDLED_OPENSSL": "OFF"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "inherits": ["_gen"],
      "description": "Do not inherit _pathWin and _pathUnix together — CMake disables the preset when either path preset is inactive."
    },
    {
      "name": "core-debug",
      "displayName": "RetDec Core (Debug, native)",
      "inherits": ["_gen", "_pathUnix", "_optionDefaults"],
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_RETDEC": "ON",
        "RETDEC_ENABLE_RETDEC_DECOMPILER": "ON",
        "RETDEC_ENABLE_FILEFORMAT": "ON",
        "RETDEC_ENABLE_BIN2LLVMIR": "ON",
        "RETDEC_ENABLE_LLVMIR2HLL": "ON",
        "RETDEC_ENABLE_DEMANGLER": "ON",
        "RETDEC_ENABLE_COMMON": "ON",
        "RETDEC_ENABLE_CONFIG": "ON"
      }
    },
    {
      "name": "core-debug-msvc",
      "displayName": "RetDec Core (Debug, MSVC — build/windows)",
      "inherits": ["_gen", "_pathWin", "_optionDefaults"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_RETDEC": "ON",
        "RETDEC_ENABLE_RETDEC_DECOMPILER": "ON",
        "RETDEC_ENABLE_FILEFORMAT": "ON",
        "RETDEC_ENABLE_BIN2LLVMIR": "ON",
        "RETDEC_ENABLE_LLVMIR2HLL": "ON",
        "RETDEC_ENABLE_DEMANGLER": "ON",
        "RETDEC_ENABLE_COMMON": "ON",
        "RETDEC_ENABLE_CONFIG": "ON"
      }
    },
    {
      "name": "core-release",
      "displayName": "RetDec Core (Release + LTO, native)",
      "inherits": ["_gen", "_pathUnix", "_optionDefaults"],
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "RETDEC_TESTS": "OFF",
        "RETDEC_ENABLE_RETDEC": "ON",
        "RETDEC_ENABLE_RETDEC_DECOMPILER": "ON",
        "RETDEC_ENABLE_FILEFORMAT": "ON",
        "RETDEC_ENABLE_BIN2LLVMIR": "ON",
        "RETDEC_ENABLE_LLVMIR2HLL": "ON",
        "RETDEC_ENABLE_DEMANGLER": "ON",
        "RETDEC_ENABLE_COMMON": "ON",
        "RETDEC_ENABLE_CONFIG": "ON"
      }
    },
    {
      "name": "core-release-msvc",
      "displayName": "RetDec Core (Release + LTO, MSVC — build/windows)",
      "inherits": ["_gen", "_pathWin", "_optionDefaults"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "RETDEC_TESTS": "OFF",
        "RETDEC_ENABLE_RETDEC": "ON",
        "RETDEC_ENABLE_RETDEC_DECOMPILER": "ON",
        "RETDEC_ENABLE_FILEFORMAT": "ON",
        "RETDEC_ENABLE_BIN2LLVMIR": "ON",
        "RETDEC_ENABLE_LLVMIR2HLL": "ON",
        "RETDEC_ENABLE_DEMANGLER": "ON",
        "RETDEC_ENABLE_COMMON": "ON",
        "RETDEC_ENABLE_CONFIG": "ON"
      }
    },
    {
      "name": "core-asan",
      "displayName": "RetDec Core (Debug + AddressSanitizer)",
      "inherits": ["core-debug", "_optionDefaults"],
      "cacheVariables": {
        "RETDEC_USE_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "core-coverage",
      "displayName": "RetDec Core (Debug + gcov line/branch coverage)",
      "inherits": ["core-debug", "_optionDefaults"],
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -O0 -fno-inline",
        "CMAKE_CXX_FLAGS": "--coverage -O0 -fno-inline",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "full-linux-debug",
      "displayName": "Full in-tree build (Debug, tests, Qt6 GUI required; CUDA accel opt-in)",
      "inherits": ["_gen", "_pathUnix", "_optionDefaults"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_CUDA_ACCEL": "OFF",
        "RETDEC_REQUIRE_QT6": "ON"
      }
    },
    {
      "name": "full-linux-release",
      "displayName": "Full in-tree build (Release + LTO, tests, Qt6 GUI required; CUDA accel opt-in)",
      "inherits": ["_gen", "_pathUnix", "_optionDefaults"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_CUDA_ACCEL": "OFF",
        "RETDEC_REQUIRE_QT6": "ON"
      }
    },
    {
      "name": "full-windows-release",
      "displayName": "Full in-tree build (Windows, Release, bundled OpenSSL, Qt6 GUI; CUDA accel opt-in)",
      "inherits": ["_gen", "_pathWin", "_optionDefaults"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_CUDA_ACCEL": "OFF",
        "RETDEC_REQUIRE_QT6": "ON",
        "RETDEC_BUNDLED_OPENSSL": "ON"
      }
    },
    {
      "name": "full-windows-debug",
      "displayName": "Full in-tree build (Windows, Debug, bundled OpenSSL, Qt6 GUI; CUDA accel opt-in)",
      "inherits": ["_gen", "_pathWin", "_optionDefaults"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RETDEC_TESTS": "ON",
        "RETDEC_ENABLE_CUDA_ACCEL": "OFF",
        "RETDEC_REQUIRE_QT6": "ON",
        "RETDEC_BUNDLED_OPENSSL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-debug-msvc",
      "configurePreset": "core-debug-msvc"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release"
    },
    {
      "name": "core-release-msvc",
      "configurePreset": "core-release-msvc"
    },
    {
      "name": "core-asan",
      "configurePreset": "core-asan"
    },
    {
      "name": "core-coverage",
      "configurePreset": "core-coverage"
    },
    {
      "name": "full-linux-debug",
      "configurePreset": "full-linux-debug"
    },
    {
      "name": "full-linux-release",
      "configurePreset": "full-linux-release"
    },
    {
      "name": "full-windows-release",
      "configurePreset": "full-windows-release"
    },
    {
      "name": "full-windows-debug",
      "configurePreset": "full-windows-debug"
    }
  ],
  "testPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "full-linux-debug",
      "configurePreset": "full-linux-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "full-windows-debug",
      "configurePreset": "full-windows-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}
