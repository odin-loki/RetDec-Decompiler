---
# QUAL-01: Imortek-new modules only (src/neural, src/gui, src/codegen,
# src/ssa, src/algo_recover, src/cli_parser, src/crypto_detect,
# src/sort_detect).
# Allowlist is toolchain-stable globs; unknown check names are not listed.
# HeaderFilterRegex limits diagnostics to those retdec/ trees so
# LLVM / Avast / Qt / system headers are not dumped into CI logs.
Checks: '-*,bugprone-*,cert-*'
WarningsAsErrors: ''
HeaderFilterRegex: 'retdec/(neural|gui|codegen|ssa|algo_recover|cli_parser|crypto_detect|sort_detect)/'
FormatStyle: none
