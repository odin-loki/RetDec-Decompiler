# cmake -P tests/log_min_level.cmake: checks the FORGE_LOG_MIN_LEVEL name -> macro value mapping.
include(${CMAKE_CURRENT_LIST_DIR}/../cmake/forge_log_level.cmake)
set(fails 0)
foreach(pair "trace=0" "debug=1" "info=2" "warn=3" "error=4" "fatal=5" "off=6" "WARN=3" "4=4" "none=" "=" "verbose=INVALID" "w=INVALID" "7=INVALID")
  string(FIND "${pair}" "=" eq)
  string(SUBSTRING "${pair}" 0 ${eq} name)
  math(EXPR vpos "${eq} + 1")
  string(SUBSTRING "${pair}" ${vpos} -1 want)
  forge_log_level_value("${name}" got)
  if(NOT "${got}" STREQUAL "${want}")
    message(SEND_ERROR "forge_log_level_value('${name}') = '${got}', want '${want}'")
    math(EXPR fails "${fails} + 1")
  endif()
endforeach()
if(fails)
  message(FATAL_ERROR "${fails} failure(s)")
endif()
message(STATUS "log_min_level: ok")
