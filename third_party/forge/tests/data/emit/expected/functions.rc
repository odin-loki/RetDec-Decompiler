#!/usr/bin/env rc
# generated by `forge script --emit rc`; runs without FORGE
fn fib { _t1=() _t2=() n=() {
    n=$1
    if (test $n -lt 2) {
        _r=$n
        return 0
    }
    fib `{expr $n - 1}
    _t1=$_r
    fib `{expr $n - 2}
    _t2=$_r
    _r=`{expr $_t1 + $_t2}
    return 0
} }
fn greet { who=() {
    who=$1
    _r='hello, '^$who^'!'
    return 0
} }
fn main { _t10=() _t11=() _t3=() _t4=() _t5=() _t6=() _t7=() _t8=() _t9=() big=() home_=() i=() n=() name=() r_code=() r_out=() total=() w=() {
    name='it''s "quoted" $HOME `x` \ *'
    greet $name
    _t3=$_r
    printf '%s\n' $_t3
    total=0
    i=0
    while (test $i -lt 10) {
        if (test `{expr $i % 3} -eq 0) {
            i=`{expr $i + 1}
            continue
        }
        total=`{expr $total + $i}
        i=`{expr $i + 1}
    }
    fib 10
    _t4=$_r
    printf '%s\n' 'total='^$total^' fib='^$_t4^' neg='^`{expr -7 / 2}
    for (w in 'a b' 'c') {
        printf '%s\n' '['^$w^']'
    }
    _t6='false'
    if (test $total -gt 20) {
        fib 5
        _t5=$_r
        if (test $_t5 -eq 5) {
            _t6='true'
        }
    }
    _t7='false'
    if (test x^$_t6 '=' x^'true') {
        _t7='true'
    }
    big=$_t7
    printf '%s\n' 'big='^$big^' len='^`{printf %s $name | wc -c}
    _t8='none'
    if (! ~ $#FORGE_EMIT_NOPE 0) {
        _t8=$^FORGE_EMIT_NOPE
    }
    home_=$_t8
    printf '%s\n' 'env='^$home_^' plat='^`{sh -c 'case $(uname -s) in Linux) if [ -n "${ANDROID_ROOT-}" ]; then echo android; else echo linux; fi;; Darwin) echo macos;; FreeBSD) echo freebsd;; MINGW*|MSYS*|CYGWIN*|Windows_NT) echo windows;; *) echo other;; esac'}
    printf '%s' 'line1
line2
' > 'forge_emit_t.txt'
    if ({test -e 'forge_emit_t.txt'} && {! {test -d 'forge_emit_t.txt'}}) {
        printf '%s' ``(){cat -- 'forge_emit_t.txt'}
    }
    rm -rf -- 'forge_emit_t.txt'
    r_out=''
    r_code=0
    _t9=``(''){sh -c '(eval "$1"); printf ''\034%d'' "$?"' _ 'printf ''%s|'' '^''''^``(){printf %s $name | sed 's/''/''"''"''/g'}^''''^'; exit 3'}
    if (~ $#_t9 1) {
        r_out=''
        r_code=$_t9(1)
    } else {
        r_out=$_t9(1)
        r_code=$_t9(2)
    }
    _t10='false'
    if (test $r_code -eq 0) {
        _t10='true'
    }
    printf '%s\n' 'out=['^$r_out^'] code='^$r_code^' ok='^$_t10
    n=0
    while (test $n -lt 5) {
        n=`{expr $n + 2}
        if (test $n -eq 4) {
            break
        }
    }
    printf '%s\n' 'n='^$n
    _t11=''
    if (test $n -gt 3) {
        _t11='gt'
    } else {
        _t11='le'
    }
    printf '%s\n' $_t11
    _r=3
    return 0
} }
main
_t12=$_r
exit $_t12
