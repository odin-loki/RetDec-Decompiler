#!/usr/bin/env ysh
# generated by `forge script --emit ysh`; runs without FORGE
var _r = ''
func _div(a, b) { if (b < 0) { return (-(a // -b)) } return (a // b) }
func _mod(a, b) { return (a - _div(a, b) * b) }
proc main {
    var name = b'it\'s "quoted" & | < > (x) ^ %PATH% !bang!'
    write -- $[(b'hello, ' ++ name ++ b'!')]
    var total = 0
    var i = 0
    while (i < 10) {
        if (_mod(i, 3) === 0) {
            setvar i = (i + 1)
            continue
        }
        setvar total = (total + i)
        setvar i = (i + 1)
    }
    write -- $[(b'total=' ++ str(total) ++ b' neg=' ++ str(_div(-7, 2)) ++ b' mod=' ++ str(_mod(-7, 2)) ++ b' sub=' ++ str((total - -3)))]
    for w in ([b'a b', b'c & d']) {
        write -- $[(b'[' ++ w ++ b']')]
    }
    for k in ([1, 2, 3]) {
        setvar total = (total + (k * 10))
    }
    var _t1 = b'false'
    if ( (total > 20) and (total !== 5)) {
        setvar _t1 = b'true'
    }
    var big = _t1
    write -- $[(b'big=' ++ big ++ b' total=' ++ str(total))]
    var e_ = get(ENV, b'FORGE_EMIT_NOPE', b'none')
    setglobal ENV[b'FORGE_EMIT_X'] = b'set (1)'
    write -- $[(b'env=' ++ e_ ++ b' x=' ++ get(ENV, b'FORGE_EMIT_X', b'?') ++ b' plat=' ++ $(sh -c b'case $(uname -s) in Linux) if [ -n "${ANDROID_ROOT-}" ]; then echo android; else echo linux; fi;; Darwin) echo macos;; FreeBSD) echo freebsd;; MINGW*|MSYS*|CYGWIN*|Windows_NT) echo windows;; *) echo other;; esac'))]
    mkdir -p -- $[b'forge_emit_dir/sub']
    write --end '' -- $[b'data'] > $[b'forge_emit_dir/sub/f.txt']
    if ( ( ($(if test -e $[b'forge_emit_dir/sub/f.txt'] { echo 1 } else { echo 0 }) === '1') and ($(if test -d $[b'forge_emit_dir'] { echo 1 } else { echo 0 }) === '1')) and (not ($(if test -d $[b'forge_emit_dir/sub/f.txt'] { echo 1 } else { echo 0 }) === '1'))) {
        write -- $[b'files ok']
    }
    rm -rf -- $[b'forge_emit_dir']
    var _t2 = b'false'
    if ($(if test -e $[b'forge_emit_dir'] { echo 1 } else { echo 0 }) === '1') {
        setvar _t2 = b'true'
    }
    write -- $[(b'gone=' ++ _t2)]
    var n = 0
    while (n < 5) {
        setvar n = (n + 2)
        if (n === 4) {
            break
        }
    }
    write -- $[(b'n=' ++ str(n))]
    var _t3 = b''
    if (n > 3) {
        setvar _t3 = b'gt'
    } else {
        setvar _t3 = b'le'
    }
    write -- $[_t3]
    if ( (name === b'x') or (n === 4)) {
        write -- $[b'or ok']
    } else {
        write -- $[b'or bad']
    }
    setglobal _r = 4
    return 0
}
main
var _t4 = _r
exit $[_t4]
