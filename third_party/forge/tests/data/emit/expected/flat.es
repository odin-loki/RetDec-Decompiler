#!/usr/bin/env es
# generated by `forge script --emit es`; runs without FORGE
fn main { local (_t1=; _t2=; _t3=; _t4=; _t5=; big=; e_=; i=; k=; n=; name=; total=; w=) {
    name='it''s "quoted" $HOME `x` \ * !bang'
    printf '%s\n' 'hello, '^$name^'!'
    total=0
    i=0
    while {test $i -lt 10} { catch @ _e _r {if {~ $_e continue} {} {throw $_e $_r}} {
        if {test `{expr $i % 3} -eq 0} {
            i=`{expr $i + 1}
            throw continue
        }
        total=`{expr $total + $i}
        i=`{expr $i + 1}
    } }
    printf '%s\n' 'total='^$total^' neg='^`{expr -7 / 2}^' mod='^`{expr -7 % 2}
    for (w = 'a b' 'c') { catch @ _e _r {if {~ $_e continue} {} {throw $_e $_r}} {
        printf '%s\n' '['^$w^']'
    } }
    for (k = 1 2 3) { catch @ _e _r {if {~ $_e continue} {} {throw $_e $_r}} {
        total=`{expr $total + `{expr $k '*' 10}}
    } }
    _t1='false'
    if {{test $total -gt 20} && {test $total -ne 5}} {
        _t1='true'
    }
    big=$_t1
    printf '%s\n' 'big='^$big^' total='^$total^' len='^`{printf %s $name | wc -c}
    _t2='none'
    if {! ~ $#FORGE_EMIT_NOPE 0} {
        _t2=$^FORGE_EMIT_NOPE
    }
    e_=$_t2
    FORGE_EMIT_X='set'
    _t3='?'
    if {! ~ $#FORGE_EMIT_X 0} {
        _t3=$^FORGE_EMIT_X
    }
    printf '%s\n' 'env='^$e_^' x='^$_t3^' plat='^`{sh -c 'case $(uname -s) in Linux) if [ -n "${ANDROID_ROOT-}" ]; then echo android; else echo linux; fi;; Darwin) echo macos;; FreeBSD) echo freebsd;; MINGW*|MSYS*|CYGWIN*|Windows_NT) echo windows;; *) echo other;; esac'}
    mkdir -p -- 'forge_emit_dir/sub'
    printf '%s' 'data' > 'forge_emit_dir/sub/f.txt'
    if {{{test -e 'forge_emit_dir/sub/f.txt'} && {test -d 'forge_emit_dir'}} && {! {test -d 'forge_emit_dir/sub/f.txt'}}} {
        printf '%s\n' 'files ok'
    }
    rm -rf -- 'forge_emit_dir'
    _t4='false'
    if {test -e 'forge_emit_dir'} {
        _t4='true'
    }
    printf '%s\n' 'gone='^$_t4
    n=0
    while {test $n -lt 5} { catch @ _e _r {if {~ $_e continue} {} {throw $_e $_r}} {
        n=`{expr $n + 2}
        if {test $n -eq 4} {
            break
        }
    } }
    printf '%s\n' 'n='^$n
    _t5=''
    if {test $n -gt 3} {
        _t5='gt'
    } {
        _t5='le'
    }
    printf '%s\n' $_t5
    if {{test x^$name '=' x^'x'} || {test $n -eq 4}} {
        printf '%s\n' 'or ok'
    } {
        printf '%s\n' 'or bad'
    }
    _r=4
    return 0
} }
main
_t6=$_r
exit $_t6
