# Elementwise op family. Format: see ops/README.md
op add      class elementwise  inputs 2  shape broadcast  tol exact     fuse yes  cost 1  doc "y = a + b (numpy broadcasting)"
op sub      class elementwise  inputs 2  shape broadcast  tol exact     fuse yes  cost 1  doc "y = a - b"
op mul      class elementwise  inputs 2  shape broadcast  tol exact     fuse yes  cost 1  doc "y = a * b"
op div      class elementwise  inputs 2  shape broadcast  tol ulp:1     fuse yes  cost 4  doc "y = a / b"
op maximum  class elementwise  inputs 2  shape broadcast  tol exact     fuse yes  cost 1  doc "y = max(a, b)"
op minimum  class elementwise  inputs 2  shape broadcast  tol exact     fuse yes  cost 1  doc "y = min(a, b)"
op pow      class elementwise  inputs 2  shape broadcast  tol rel:1e-5  fuse yes  cost 20 doc "y = a ^ b"
op fma      class elementwise  inputs 3  shape broadcast  tol exact     fuse yes  cost 2  doc "y = a * b + c (single rounding)"
op select   class elementwise  inputs 3  shape broadcast  tol exact     fuse yes  cost 1  doc "y = c != 0 ? a : b  (inputs: a, b, cond)"
op neg      class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  doc "y = -x"
op abs      class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  doc "y = |x|"
op sqrt     class elementwise  inputs 1  shape same       tol ulp:1     fuse yes  cost 4  doc "y = sqrt(x)"
op rsqrt    class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 4  doc "y = 1 / sqrt(x)"
op recip    class elementwise  inputs 1  shape same       tol ulp:1     fuse yes  cost 4  doc "y = 1 / x"
op square   class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  doc "y = x * x"
op exp      class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = e^x"
op exp2     class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = 2^x"
op expm1    class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = e^x - 1"
op log      class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = ln x"
op log2     class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = log2 x"
op log1p    class elementwise  inputs 1  shape same       tol rel:1e-6  fuse yes  cost 10 doc "y = ln(1 + x)"
op sin      class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 12 doc "y = sin x"
op cos      class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 12 doc "y = cos x"
op tan      class elementwise  inputs 1  shape same       tol rel:1e-5  fuse yes  cost 14 doc "y = tan x"
op tanh     class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 12 doc "y = tanh x"
op sinh     class elementwise  inputs 1  shape same       tol rel:1e-5  fuse yes  cost 12 doc "y = sinh x"
op cosh     class elementwise  inputs 1  shape same       tol rel:1e-5  fuse yes  cost 12 doc "y = cosh x"
op asin     class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 14 doc "y = asin x"
op acos     class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 14 doc "y = acos x"
op atan     class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 14 doc "y = atan x"
op erf      class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 14 doc "y = erf x"
op erfc     class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 14 doc "y = erfc x"
op sigmoid  class elementwise  inputs 1  shape same       tol abs:1e-6  fuse yes  cost 12 doc "y = 1 / (1 + e^-x)"
op silu     class elementwise  inputs 1  shape same       tol abs:1e-5  fuse yes  cost 12 doc "y = x * sigmoid(x)"
op gelu     class elementwise  inputs 1  shape same       tol abs:1e-5  fuse yes  cost 14 doc "y = 0.5 x (1 + erf(x / sqrt 2))"
op gelu_tanh class elementwise inputs 1  shape same       tol abs:1e-5  fuse yes  cost 14 doc "tanh approximation of gelu"
op relu     class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  doc "y = max(x, 0)"
op softplus class elementwise  inputs 1  shape same       tol abs:1e-5  fuse yes  cost 14 doc "y = ln(1 + e^x)"
op scale    class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  attrs "alpha" doc "y = alpha * x"
op convert  class elementwise  inputs 1  shape same       tol exact     fuse yes  cost 1  attrs "to" doc "round-trip x through dtype `to` (f16/bf16/fp8_e4m3/fp8_e5m2)"
