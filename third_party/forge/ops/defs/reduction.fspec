op reduce_sum   class reduction  inputs 1  shape reduce  tol rel:1e-5  fuse no  cost 1  attrs "axis" doc "sum over axis (keepdims=false)"
op reduce_max   class reduction  inputs 1  shape reduce  tol exact     fuse no  cost 1  attrs "axis" doc "max over axis"
op reduce_min   class reduction  inputs 1  shape reduce  tol exact     fuse no  cost 1  attrs "axis" doc "min over axis"
op reduce_mean  class reduction  inputs 1  shape reduce  tol rel:1e-5  fuse no  cost 1  attrs "axis" doc "mean over axis"
op argmax       class reduction  inputs 1  shape reduce  tol exact     fuse no  cost 1  attrs "axis" doc "index of max over axis (as float)"
op logsumexp    class reduction  inputs 1  shape reduce  tol rel:1e-5  fuse no  cost 12 attrs "axis" doc "log(sum(exp(x))) over axis, stable"
op softmax      class reduction  inputs 1  shape same    tol abs:1e-6  fuse no  cost 14 doc "softmax over last axis"
op rms_norm     class reduction  inputs 2  shape same    tol rel:1e-5  fuse no  cost 4  attrs "eps" doc "x / sqrt(mean(x^2) + eps) * w over last axis"
op layer_norm   class reduction  inputs 3  shape same    tol rel:1e-5  fuse no  cost 6  attrs "eps" doc "(x - mean) / sqrt(var + eps) * w + b over last axis"
op cumsum       class reduction  inputs 1  shape same    tol rel:1e-5  fuse no  cost 1  attrs "axis" doc "inclusive prefix sum over axis"
op moe_gate     class reduction  inputs 1  shape same    tol abs:1e-6  fuse no  cost 16 attrs "k,norm" doc "MoE router: softmax over last axis, keep top-k (ties -> lower index), renormalise if norm"
