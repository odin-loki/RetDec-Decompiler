# Mixtral-style sparse MoE decoder (Mixtral 8x7B / 8x22B layout).
# Router: softmax over experts, keep top-k, renormalise (HF MixtralSparseMoeBlock).
# Sparse: moe_ffn evaluates only each token's k experts. Experts are stored stacked per layer:
# W.layer[l].experts.w_gate / w_up [n_experts, ffn, d_model], w_down [n_experts, d_model, ffn].
blueprint "decoder-lm-moe" opset 1

params {
  d_model: {{hidden_size}}  n_layers: {{num_hidden_layers}}  n_heads: {{num_attention_heads}}
  n_kv: {{num_key_value_heads}}  head_dim: {{head_dim}}  ffn: {{intermediate_size}}
  vocab: {{vocab_size}}  eps: {{rms_norm_eps}}
  n_experts: {{num_local_experts}}  n_active: {{num_experts_per_tok}}
  rope: { base: {{rope_theta}} }
}

state kv[n_layers] : kv_cache(heads: n_kv, dim: head_dim)

input tokens    : f32[seq]
input positions : f32[seq]

graph {
  x = embed(W.tok_emb, tokens)
  repeat l in 0..n_layers {
    h = rms_norm(x, W.layer[l].attn_norm, eps)
    q = rope(heads(linear(h, W.layer[l].wq), n_heads, head_dim), positions, base: rope.base, neox: {{rope_neox}})
    k = rope(heads(linear(h, W.layer[l].wk), n_kv, head_dim), positions, base: rope.base, neox: {{rope_neox}})
    v = heads(linear(h, W.layer[l].wv), n_kv, head_dim)
    kk, vv = kv[l].append(k, v)
    a = attention(q, kk, vv, causal: true, groups: n_heads / n_kv)
    x = x + linear(merge(a, n_heads * head_dim), W.layer[l].wo)
    h = rms_norm(x, W.layer[l].ffn_norm, eps)
    x = x + moe_ffn(h, linear(h, W.layer[l].router), W.layer[l].experts.w_gate, W.layer[l].experts.w_up, W.layer[l].experts.w_down,
                    k: n_active, norm: 1)
  }
  logits = linear(rms_norm(last(x, seq), W.out_norm, eps), W.lm_head)
}

output logits : f32[1, vocab]
session generative_sequence
