# Cross-links tests/dynlib_fixture.c into foreign binary formats for test_os_dynlib (os::file_symbols parsers):
# PE32+/PE32 DLLs (lld-link), Mach-O dylibs incl. an exports-trie and a fat one (ld64.lld, llvm-lipo), and ELF variants
# (32-bit, big-endian, stripped section headers with DT_HASH / DT_GNU_HASH, symbol versions + IFUNC + TLS).
# Each fixture is optional: a tool that is missing or fails only drops that file (the test reports what it checked).
#   cmake -DCLANG=... -DLLD_LINK=... -DLD64=... -DLIPO=... -DOBJCOPY=... -DSRC=tests/dynlib_fixture.c -DOUT=<dir> -P cmake/dynlib_fixtures.cmake
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
function(step out)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(STATUS "dynlib fixture ${out} not built: ${e}")
    file(REMOVE ${OUT}/${out})
    set(ok FALSE PARENT_SCOPE)
  endif()
endfunction()
macro(fixture out)
  set(ok TRUE)
  foreach(cmd IN ITEMS ${ARGN})
    if(ok)
      string(REPLACE "|" ";" cmd "${cmd}")
      step(${out} ${cmd})
    endif()
  endforeach()
endmacro()

if(CLANG AND LLD_LINK)
  file(WRITE ${OUT}/fx.def "EXPORTS\n  forge_fixture_add\n  forge_fixture_name\n  forge_fixture_counter DATA\n  forge_fixture_fwd = KERNEL32.GetTickCount\n")
  fixture(pe64.dll "${CLANG}|--target=x86_64-pc-windows-msvc|-O1|-c|${SRC}|-o|${OUT}/pe64.obj"
                   "${LLD_LINK}|/dll|/noentry|/nodefaultlib|/machine:x64|/def:${OUT}/fx.def|/out:${OUT}/pe64.dll|${OUT}/pe64.obj")
  fixture(pe32.dll "${CLANG}|--target=i686-pc-windows-msvc|-O1|-c|${SRC}|-o|${OUT}/pe32.obj"
                   "${LLD_LINK}|/dll|/noentry|/nodefaultlib|/machine:x86|/def:${OUT}/fx.def|/out:${OUT}/pe32.dll|${OUT}/pe32.obj")
endif()
if(CLANG AND LD64)
  foreach(a arm64 x86_64)
    fixture(macho_${a}.dylib "${CLANG}|--target=${a}-apple-macos11|-O1|-c|${SRC}|-o|${OUT}/macho_${a}.o"
                             "${LD64}|-dylib|-arch|${a}|-platform_version|macos|11.0|11.0|-install_name|@rpath/libforge_fixture.dylib|-o|${OUT}/macho_${a}.dylib|${OUT}/macho_${a}.o")
  endforeach()
  fixture(macho_trie.dylib "${LD64}|-dylib|-arch|arm64|-platform_version|macos|13.0|13.0|-fixup_chains|-o|${OUT}/macho_trie.dylib|${OUT}/macho_arm64.o")
  if(LIPO AND EXISTS ${OUT}/macho_arm64.dylib AND EXISTS ${OUT}/macho_x86_64.dylib)
    fixture(macho_fat.dylib "${LIPO}|-create|${OUT}/macho_x86_64.dylib|${OUT}/macho_arm64.dylib|-output|${OUT}/macho_fat.dylib")
  endif()
endif()
if(CLANG)
  set(_so -fPIC -O1 -shared -nostdlib -fuse-ld=lld)
  string(REPLACE ";" "|" _so "${_so}")
  file(WRITE ${OUT}/fx.map "FIXV_1 { local: forge_fixture_add_v1; };\nFIXV_2 { global: *; } FIXV_1;\n")
  fixture(elf_ver.so "${CLANG}|--target=x86_64-linux-gnu|${_so}|-DFIXTURE_ELF_EXTRAS|-Wl,--version-script=${OUT}/fx.map|-o|${OUT}/elf_ver.so|${SRC}")
  fixture(elf32.so "${CLANG}|--target=i686-linux-gnu|${_so}|-Wl,--hash-style=sysv|-o|${OUT}/elf32.so|${SRC}")
  fixture(elf_be.so "${CLANG}|--target=powerpc64-linux-gnu|${_so}|-o|${OUT}/elf_be.so|${SRC}")
  fixture(elf_gnu.so "${CLANG}|--target=x86_64-linux-gnu|${_so}|-Wl,--hash-style=gnu|-o|${OUT}/elf_gnu.so|${SRC}")
  if(OBJCOPY)
    if(EXISTS ${OUT}/elf_gnu.so)
      fixture(elf_gnu_nosec.so "${OBJCOPY}|--strip-sections|${OUT}/elf_gnu.so|${OUT}/elf_gnu_nosec.so")
    endif()
    if(EXISTS ${OUT}/elf32.so)
      fixture(elf32_nosec.so "${OBJCOPY}|--strip-sections|${OUT}/elf32.so|${OUT}/elf32_nosec.so")
    endif()
  endif()
endif()
file(GLOB _junk ${OUT}/*.o ${OUT}/*.obj ${OUT}/*.lib ${OUT}/*.exp)
if(_junk)
  file(REMOVE ${_junk})
endif()
file(WRITE ${OUT}/stamp "")
