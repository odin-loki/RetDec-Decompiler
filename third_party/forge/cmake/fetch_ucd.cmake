# Downloads the Unicode 16.0.0 conformance files into tests/data/ucd (gitignored) for test_text_conformance.
set(_ucd "${CMAKE_CURRENT_LIST_DIR}/../tests/data/ucd")
set(_base "https://www.unicode.org/Public/16.0.0/ucd")
foreach(f NormalizationTest.txt auxiliary/GraphemeBreakTest.txt auxiliary/WordBreakTest.txt auxiliary/SentenceBreakTest.txt
          auxiliary/LineBreakTest.txt BidiCharacterTest.txt)
  get_filename_component(_n ${f} NAME)
  if(NOT EXISTS "${_ucd}/${_n}")
    file(DOWNLOAD "${_base}/${f}" "${_ucd}/${_n}" STATUS _st)
  endif()
endforeach()
if(NOT EXISTS "${_ucd}/CollationTest_SHIFTED_SHORT.txt")
  file(DOWNLOAD "https://www.unicode.org/Public/UCA/16.0.0/CollationTest.zip" "${_ucd}/CollationTest.zip" STATUS _st)
  file(ARCHIVE_EXTRACT INPUT "${_ucd}/CollationTest.zip" DESTINATION "${_ucd}" PATTERNS "*SHORT.txt")
  file(GLOB _c "${_ucd}/CollationTest/*SHORT.txt")
  foreach(x ${_c})
    get_filename_component(_n ${x} NAME)
    file(RENAME ${x} "${_ucd}/${_n}")
  endforeach()
endif()
